+/* Build and emit named constant labels.  For ELF targets, use plain
+   LC<number> names so the assembler keeps local readonly constants as
+   symbols, then mark them as STT_OBJECT with a deterministic size.  */
+
+static void
+build_constant_label (label, prefix, labelno)
+     char *label;
+     char *prefix;
+     int labelno;
+{
+#ifdef OBJECT_FORMAT_ELF
+  sprintf (label, "*%s%d", prefix, labelno);
+#else
+  ASM_GENERATE_INTERNAL_LABEL (label, prefix, labelno);
+#endif
+}
+
+static void
+output_constant_label (prefix, labelno)
+     char *prefix;
+     int labelno;
+{
+  char label[256];
+
+  build_constant_label (label, prefix, labelno);
+#ifdef OBJECT_FORMAT_ELF
+  fprintf (asm_out_file, "\t.type\t");
+  assemble_name (asm_out_file, label);
+  fprintf (asm_out_file, ",@object\n");
+#endif
+  assemble_name (asm_out_file, label);
+  fprintf (asm_out_file, ":\n");
+}
+
+static void
+output_constant_size (prefix, labelno, size)
+     char *prefix;
+     int labelno;
+     int size;
+{
+#ifdef OBJECT_FORMAT_ELF
+  char label[256];
+
+  build_constant_label (label, prefix, labelno);
+  fprintf (asm_out_file, "\t.size\t");
+  assemble_name (asm_out_file, label);
+  fprintf (asm_out_file, ",%d\n", size);
+#endif
+}
