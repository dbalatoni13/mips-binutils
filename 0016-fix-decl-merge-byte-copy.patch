--- a/gcc/cp/decl.c	2026-03-30 18:15:45.065993384 +0200
+++ b/gcc/cp/decl.c	2026-03-30 18:15:45.067640340 +0200
@@ -3148,6 +3148,32 @@
    If safely possible, alter OLDDECL to look like NEWDECL, and return 1.
    Otherwise, return 0.  */
 
+/* duplicate_decls clobbers declaration nodes that live in obstack-managed
+   storage.  Keep these copies as explicit byte moves instead of relying on
+   the host compiler's bcopy expansion; Windows x86 host -O3 was observed to
+   miscompile this path in cc1plus.  */
+
+static void
+copy_decl_bytes (dst, src, size)
+     char *dst;
+     const char *src;
+     size_t size;
+{
+  if (dst == src || size == 0)
+    return;
+
+  if (dst < src || dst >= src + size)
+    while (size-- != 0)
+      *dst++ = *src++;
+  else
+    {
+      dst += size;
+      src += size;
+      while (size-- != 0)
+        *--dst = *--src;
+    }
+}
+
 int
 duplicate_decls (newdecl, olddecl)
      tree newdecl, olddecl;
